{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "node",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "dist",
		"baseUrl": ".",
		"paths": {
			"*": [ "node_modules/*" ],
			"#/*": [ "src/*" ]
		},
		"types": ["node"]
	},
	"include": [ "**/*.ts", "**/*.tsx" ],
	"exclude": [ "node_modules", "dist" ]
}